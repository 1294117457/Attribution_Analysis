@startuml StockInfo_N1_Fix

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam classFontSize 13
skinparam packageFontSize 14

' ═══════════════════════════════════════════════════════════════════════════
'  StockInfo N+1 优化 — 围绕 StockInfo 聚合根的类设计
'  主题：将"列表 + N 次反向查询池"合并为单次请求返回
' ═══════════════════════════════════════════════════════════════════════════

legend right
  |= 颜色 |= 含义 |
  | <#C8E6C9>绿 | 新增（NEW） |
  | <#FFE0B2>橙 | 修改（CHANGED） |
  | <#E0E0E0>灰 | 不变（UNCHANGED） |
endlegend


' ═══════════════════════════════════════════════════════════════════════════
'  1. 持久层（DB / ORM）— 完全不变
' ═══════════════════════════════════════════════════════════════════════════
package "持久层 (Persistence / ORM)" #ECEFF1 {

  class StockInfoDB <<UNCHANGED>> #E0E0E0 {
    + symbol {PK}
    + name, industry, market ...
    + list_date, list_status ...
  }

  class StockPoolDB <<UNCHANGED>> #E0E0E0 {
    + id {PK}
    + name, pool_type ...
    + is_default, is_archived ...
  }

  class StockPoolMemberDB <<UNCHANGED>> #E0E0E0 {
    + pool_id {PK,FK}
    + symbol {PK,FK}
    + memo, sort_order, added_at
  }

}

StockPoolDB "1" --o "0..*" StockPoolMemberDB : pool_id
StockInfoDB "1" --o "0..*" StockPoolMemberDB : symbol


' ═══════════════════════════════════════════════════════════════════════════
'  2. 领域层 — StockInfo 聚合根不变，仅新增值对象
' ═══════════════════════════════════════════════════════════════════════════
package "领域层 (Domain)" #F5F5DC {

  ' ── StockInfo 聚合根 ──────────────────────────────────
  class StockInfo <<聚合根, UNCHANGED>> #E0E0E0 {
    + symbol
    + name
    + industry : Industry?
    + market : Market?
    --
    to_dict / create
  }

  class StockPool <<聚合根, UNCHANGED>> #E0E0E0 {
    + id, name
    + pool_type : PoolType
    + is_default, is_archived
  }

  ' ── 新增：StockPoolBrief 值对象 ──────────────────────────
  class StockPoolBrief <<值对象, NEW>> #C8E6C9 {
    + pool_id : int
    + name : str
    + pool_type : str
    --
    __ 用于列表场景的轻量快照 __
    __ 不包含 members / color / icon __
  }

}

StockInfo ..> StockPoolBrief : <<查询时附带>>
StockPool ..> StockPoolBrief : <<投影/降维>>


' ═══════════════════════════════════════════════════════════════════════════
'  3. 仓储层 — 新增批量反向查询方法
' ═══════════════════════════════════════════════════════════════════════════
package "仓储层 (Repository)" #F3E5F5 {

  class StockInfoRepository <<UNCHANGED>> #E0E0E0 {
    + list_with_kline_stats_paginated() : tuple[list[dict], int]
  }

  class StockPoolRepository <<CHANGED>> #FFE0B2 {
    + find_pools_by_symbol(symbol) : list[StockPool]  <<旧, 保留>>
    + list_membership_by_symbols(symbols) <<新>>
      : dict[symbol, list[StockPoolBrief]]
  }

  class StockRepoImpl <<UNCHANGED>> #E0E0E0
  class PoolRepoImpl <<CHANGED>> #FFE0B2 {
    + 实现 list_membership_by_symbols
    __ 用 symbol IN (:symbols) + is_archived=False __
    __ 单次 SQL 返回全部映射 __
  }

  StockInfoRepository <|.. StockRepoImpl
  StockPoolRepository <|.. PoolRepoImpl

}

StockRepoImpl ..> StockInfoDB
PoolRepoImpl ..> StockPoolMemberDB
PoolRepoImpl ..> StockPoolDB


' ═══════════════════════════════════════════════════════════════════════════
'  4. 应用服务层 — 编排合并逻辑
' ═══════════════════════════════════════════════════════════════════════════
package "应用服务 (Application)" #E3F2FD {

  class StockAppService <<CHANGED>> #FFE0B2 {
    + query_stocks(request)
    __ 1) repo.list_with_kline_stats_paginated() __
    __ 2) 若 with_pools=True: __
    __    pool_repo.list_membership_by_symbols() __
    __ 3) 合并 pools 到每个 stock item __
  }

  class StockPoolAppService <<UNCHANGED>> #E0E0E0 {
    + find_pools_by_symbol() <<保留, 给详情页用>>
  }

  StockAppService --> StockRepoImpl
  StockAppService --> PoolRepoImpl : <<新依赖>>
  StockPoolAppService --> PoolRepoImpl

}


' ═══════════════════════════════════════════════════════════════════════════
'  5. DTO 层 — 新增轻量 VO + 修改 StockQueryItemResponse
' ═══════════════════════════════════════════════════════════════════════════
package "DTO 层 (API Boundary)" #FFF3E0 {

  class PoolMembershipVO <<NEW>> #C8E6C9 {
    + pool_id : int
    + name : str
    + pool_type : str
    __ 列表展示专用, 不含 color/icon __
  }

  class StockQueryRequest <<CHANGED>> #FFE0B2 {
    + q, industry, market ...
    + with_pools : bool = False <<新参数>>
  }

  class StockQueryItemResponse <<CHANGED>> #FFE0B2 {
    + symbol, name, industry ...
    + latest_close, total_mv, pe_ttm ...
    + pools : list[PoolMembershipVO] <<新字段>>
    __ 默认空列表, with_pools=True 时填充 __
  }

  class StockQueryResponse <<UNCHANGED>> #E0E0E0 {
    + total
    + items : list[StockQueryItemResponse]
  }

  StockQueryItemResponse "1" *-- "0..*" PoolMembershipVO

}


' ═══════════════════════════════════════════════════════════════════════════
'  6. 路由层 — 新增 query 参数
' ═══════════════════════════════════════════════════════════════════════════
package "路由层 (Route)" #FCE4EC {

  class GET_Stocks <<CHANGED>> #FFE0B2 {
    GET /api/v1/stocks/
    + with_pools : bool = False <<新 query 参数>>
  }

  class GET_PoolsBySymbol <<UNCHANGED>> #E0E0E0 {
    GET /api/v1/pools/by-symbol/{symbol}
    __ 单股查询保留, 详情页/其他场景用 __
  }

}


' ═══════════════════════════════════════════════════════════════════════════
'  7. 调用对比（前后 HTTP 数）— 用类图节点表示，不混用 actor/boundary
' ═══════════════════════════════════════════════════════════════════════════
package "调用对比 (Before vs After)" #FAFAFA {

  class "Frontend\n(StockInfoList.vue)" as FE <<UI>> #E0E0E0 {
    + 列表 + 池信息展示
  }

  class "Before: 21 HTTP / 页" as Before <<OLD>> #FFCDD2 {
    + 1× GET /stocks/?page=1&page_size=20
    + 20× GET /pools/by-symbol/{symbol}
    __ 每个 symbol 一次反向查询 __
  }

  class "After: 1 HTTP / 页" as After <<NEW>> #C8E6C9 {
    + 1× GET /stocks/?page=1&page_size=20&with_pools=true
    __ 单次响应, items[].pools 已含池信息 __
  }

}

FE --> Before
FE --> After


' ═══════════════════════════════════════════════════════════════════════════
'  关系汇总
' ═══════════════════════════════════════════════════════════════════════════
StockAppService ..> StockQueryRequest : <<读取 with_pools>>
StockAppService ..> StockQueryItemResponse : <<构造>>
StockAppService ..> PoolMembershipVO : <<组装>>
GET_Stocks --> StockAppService
GET_PoolsBySymbol --> StockPoolAppService

' 领域依赖
StockAppService ..> StockInfo : <<返回领域层数据>>
StockPoolBrief ..> StockPool : <<投影>>

@enduml
