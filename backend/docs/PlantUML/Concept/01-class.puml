@startuml Concept_Feature_ClassOverview

title 概念板块（AKShare）— 跨层类图修改概览

left to right direction

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13

' ═════════════════════════════════════════════════════════════════════════════════════════════
'  概念板块接入方案（AKShare 数据源）
'  统一设计文档：docs/dev/06gainian/README.md
'  详细设计说明：
'    · 01-domain-design.md                — 领域层（BO/Entity/VO/Repository Protocol）
'    · 02-infrastructure-design.md         — DB/ORM/Repository/Collector/AKShare Fetcher
'    · 03-application-and-route-design.md  — DTO/Service/Route/前端
'
'  数据治理决策：⭐ 采用「独立聚合」而非「合并到 stock_infos」
'    理由：
'    ① 概念是 N:M 关系，与 stock_info 的 1:1 语义冲突
'    ② 同步周期不同：stock_info（Tushare，低频）vs concept（AKShare，高频）
'    ③ 数据源不同：避免违反 SRP
'    ④ 与现有 stock_pools + stock_pool_members 模式 1:1 对齐
'    ⑤ 查询性能：symbol IN (:symbols) 命中索引，避免全表扫描
' ═════════════════════════════════════════════════════════════════════════════════════════════

legend right
  |= 颜色 |= 含义 |
  | <#C8E6C9>绿 | 新增（NEW） |
  | <#FFE0B2>橙 | 修改（CHANGED） |
  | <#E0E0E0>灰 | 不变（UNCHANGED） |
endlegend


' ═════════════════════════════════════════════════════════════════════════════════════════════
'  1. 持久层（DB / ORM）— 2 张新表
' ═════════════════════════════════════════════════════════════════════════════════════════════
package "持久层 (Persistence / ORM)" #ECEFF1 {

  class StockInfoDB <<UNCHANGED>> #E0E0E0 {
    + symbol {PK}
    + name
    + industry      ' ← 1:1 字段，Tushare 低频同步
    + market
    + ...
    --
    __ 概念通过 stock_concept_members 间接关联，不直接持有 __
  }

  class "concepts" as ConceptsDB <<NEW>> #C8E6C9 {
    + id {PK}
    + name {UQ}      ' ← (name, source) 联合唯一
    + source         ' ← "em" / "ths"
    + concept_type   ' ← industry/theme/style/region/event/other
    + description?
    + stock_count    ' ← 采集时记录
    + is_active       ' ← 软删除（FALSE 时保留历史）
    + first_seen_at  ' ← 不变
    + last_synced_at ' ← 每次 sync 更新
    --
    __ 索引 __
    ix_concepts_source
    ix_concepts_active (WHERE is_active=TRUE)
  }

  class "stock_concept_members" as ConceptMemberDB <<NEW>> #C8E6C9 {
    + symbol {PK,FK}
    + concept_id {PK,FK}
    + joined_at
    + source
    --
    __ 索引 __
    ix_concept_member_symbol
    ix_concept_member_concept
    --
    __ 注意：symbol 不引用 stock_infos（已退市股票仍保留历史）__
  }

  StockInfoDB ..> ConceptMemberDB    : <<间接关联>>
  ConceptsDB  ..> ConceptMemberDB     : <<1:N>>
}


' ═════════════════════════════════════════════════════════════════════════════════════════════
'  2. 采集层（Collectors / ACL）
' ═════════════════════════════════════════════════════════════════════════════════════════════
package "采集层 (Collectors / ACL)" #ECEFF1 {

  ' ── Protocol（已定义于 protocols.py）───────────────────────
  class ConceptFetcher <<UNCHANGED>> #E0E0E0 {
    + fetch_concept_list() : list[Any]
    + fetch_concept_stocks(name) : list[Any]
    + source_name : str
  }

  ' ── AKShare 实现 ────────────────────────────────────────
  class AkShareConceptFetcher <<NEW>> #C8E6C9 {
    + source_name = "AkShare"
    + fetch_concept_list() : list[ConceptListBO]
    + fetch_concept_stocks(name) : list[ConceptStockBO]
    --
    + _ensure_ak()                ' 延迟 import
    + _fetch_with_retry(fn, retries=2)
    + _parse_list(df) : list[ConceptListBO]  ' 静态
    + _parse_stocks(df, name) : list[ConceptStockBO]  ' 静态
    --
    RETRY_DELAY = 1.0s
    REQUEST_DELAY = 0.3s
  }

  class AkShareParser <<NEW>> #C8E6C9 {
    + parse_list(df) : list[ConceptListBO]
    + parse_stocks(df, concept_name) : list[ConceptStockBO]
    --
    __ 解析东方财富 DataFrame，异常行跳过不中断 __
  }

  ' ── 同步任务编排 ─────────────────────────────────────────
  class ConceptSyncOperation <<NEW>> #C8E6C9 {
    - _repo : ConceptRepository
    - _fetcher : ConceptFetcher
    --
    + sync_all() : ConceptSyncResult
    - _sync_one(bo) : int
    --
    __ 步骤：fetch_concept_list → upsert_concept → fetch_concept_stocks → upsert_members __
  }

  ' ── 注册中心 ────────────────────────────────────────────
  class FetcherRegistry <<CHANGED>> #FFE0B2 {
    + register_factory(ConceptFetcher, AkShareConceptFetcher)
    + get_fetcher(ConceptFetcher) : ConceptFetcher
  }

  ConceptFetcher           <|.. AkShareConceptFetcher : <<实现>>
  AkShareConceptFetcher   --> AkShareParser           : <<委托解析>>
  FetcherRegistry        ..> AkShareConceptFetcher    : <<注册>>
  ConceptSyncOperation    --> ConceptFetcher          : <<使用>>
}


' ═════════════════════════════════════════════════════════════════════════════════════════════
'  3. 领域层（Domain）
' ═════════════════════════════════════════════════════════════════════════════════════════════
package "领域层 (Domain)" #ECEFF1 {

  ' ── 枚举 ────────────────────────────────────────────────
  class ConceptSource <<NEW>> #C8E6C9 {
    + EM = "em"      ' 东方财富（默认）
    + THS = "ths"    ' 同花顺
  }

  class ConceptType <<NEW>> #C8E6C9 {
    + INDUSTRY = "industry"  ' 行业概念
    + THEME = "theme"       ' 主题概念（如"碳中和"）
    + STYLE = "style"       ' 风格概念（如"高股息"）
    + REGION = "region"     ' 地域概念（如"雄安"）
    + EVENT = "event"       ' 事件概念（如"中字头"）
    + OTHER = "other"
  }

  ' ── BO：业务对象（采集层 → 应用层）─────────────────────────
  class ConceptListBO <<NEW>> #C8E6C9 {
    + name : str
    + code : str
    + source : ConceptSource
    + concept_type : ConceptType
    + stock_count : int = 0
    + description? : str
    + raw_payload? : dict
    --
    + to_entity() : Concept
    + normalize_name(v)  ' 去噪声字符
  }

  class ConceptStockBO <<NEW>> #C8E6C9 {
    + symbol : str
    + name : str
    + source : ConceptSource
    + rank? : int
    + latest_price? : float
    --
    + to_entity(concept_id) : ConceptMember
    + normalize_symbol()   ' zfill(6)
  }

  ' ── 实体（聚合根）───────────────────────────────────────
  class Concept <<NEW>> #C8E6C9 {
    - id? : int
    - name : str
    - source : ConceptSource
    - concept_type : ConceptType
    - description?
    - stock_count : int = 0
    - is_active : bool = True
    - first_seen_at : datetime
    - last_synced_at? : datetime
    --
    + create(...) : Concept         ' 工厂方法
    + mark_synced(member_count, at?)  ' 同步后调用
    + deactivate()              ' 软删除
    --
    __ 不变式：name + source 联合唯一__
  }

  class ConceptMember <<NEW>> #C8E6C9 {
    - symbol : str
    - concept_id : int
    - source : ConceptSource
    - joined_at : datetime
    --
    + create(...) : ConceptMember
    --
    __ 不变式：(symbol, concept_id) 联合唯一__
  }

  ' ── 值对象（不可变，只读）─────────────────────────────────
  class ConceptBriefVO <<NEW, frozen>> #C8E6C9 {
    + concept_id : int
    + name : str
    + source : str
    --
    __ 嵌入到 StockPanelItemVO.concepts __
  }

  ' ── 领域异常 ────────────────────────────────────────────
  class ConceptNotFoundError <<NEW>> #C8E6C9 {
    + message : str
    + __init__(id?, name?)
  }

  ' ── Repository Protocol ──────────────────────────────────
  class ConceptRepository <<NEW, Protocol>> #C8E6C9 {
    + upsert_concept(c: Concept) : Concept
    + upsert_members(concept_id, members) : int
    + get_concept_by_id(id) : Optional[Concept]
    + get_concept_by_name(name, source) : Optional[Concept]
    + list_concepts_by_symbol(symbol) : list[ConceptBriefVO]
    + list_concepts_by_symbols(symbols) : dict[symbol, list[ConceptBriefVO]]
    + list_concepts_by_symbol_grouped(symbol) : list[ConceptGroupedVO]  ← 🆕 抽屉 Tab 用
    + list_concepts(...) : tuple[list[Concept], int]
    + count_concepts(...) : int
    + get_last_synced_at(source) : Optional[datetime]
  }

  ' ── 既有 panel 协议（修改：新增 concept 反查）───────────────
  class StockPanelComposeRepository <<CHANGED>> #FFE0B2 {
    + list_paginated(...)
    + list_membership_by_symbols(symbols) : dict
    + list_concepts_by_symbols(symbols) : dict  ← 🆕
  }

  ' ── 关系 ────────────────────────────────────────────────
  ConceptSource    -[hidden]- ConceptType
  ConceptListBO   ..> Concept             : <<to_entity>>
  ConceptStockBO  ..> ConceptMember        : <<to_entity>>
  ConceptMember   --> Concept             : <<FK>>
  ConceptRepository ..> Concept             : <<聚合根>>
  ConceptRepository ..> ConceptMember      : <<子实体>>
  ConceptRepository ..> ConceptBriefVO     : <<查询投影>>
  ConceptRepository ..> StockPanelComposeRepository
      : <<list_concepts_by_symbols 委托>>
}


