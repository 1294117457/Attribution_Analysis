  class ConceptListVO <<NEW>> #C8E6C9 {
    __ extends Page[ConceptItemVO] __
  }

  ' ── Service ──────────────────────────────────────────────
  class ConceptAppService <<NEW>> #C8E6C9 {
    - _repo : ConceptRepository
    - _fetcher : ConceptFetcher
    --
    + sync_concepts(req) : ConceptSyncResultVO
