# backend-java env (compose env_file). Spring Boot maps SPRING_* to spring.*.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/attribution
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# 连接池（HikariCP）——见 docs/规范文档/横切技术规范/基础设施规范.md §2.2
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000
DB_POOL_LEAK_DETECTION=60000

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Redis 连接池（Lettuce）——见 docs/规范文档/横切技术规范/基础设施规范.md §3.6
# 注：启用 lettuce.pool.* 需先引入 commons-pool2 依赖，否则配置不生效。
# 本项目未引入，故不配置。如需启用，先加依赖再回填下列变量。
# REDIS_POOL_MAX_ACTIVE=16
# REDIS_POOL_MAX_IDLE=8
# REDIS_POOL_MIN_IDLE=2
# REDIS_POOL_MAX_WAIT=2000

COLLECTOR_BASE_URL=http://collector:8001
JWT_SECRET=change-me-32bytes-minimum-secret-key!!
SMTP_USERNAME=
SMTP_PASSWORD=

# CORS 允许的跨域来源（逗号分隔）——生产必须覆盖为实际前端域名
# 见 docs/规范文档/横切技术规范/基础设施规范.md §6.1
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
