# 邮件 SMTP 配置 — 用于邮箱验证码
# 复制为 .env.local 同级目录下的 .env.smtp.local 后填入实际值(本文件不入 git)
#
# 推荐:使用 QQ 邮箱「授权码」(不是登录密码)
# 申请路径:QQ 邮箱网页版 → 设置 → 账户 → POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务 → 开启「SMTP服务」→ 生成授权码
#
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=你的QQ邮箱@qq.com
SMTP_PASSWORD=你的授权码
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_SUBJECT_PREFIX=[归因分析]

# 业务"系统账号"白名单(英文逗号分隔),这些邮箱不受 1 小时 5 次的限流
# 仅在 SMTP_PASSWORD 配置完成后才有意义
SYSTEM_ACCOUNTS=zch
