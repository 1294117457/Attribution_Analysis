# 本地开发环境 - 指向远端 PostgreSQL（8.148.204.54）
# 注意：这份文件已加入 .gitignore，不要提交

# ---------- 服务 ----------
PORT=8000
HOST=0.0.0.0
DEBUG=true

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@8.148.204.54:5432/attribution

# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------- CORS ----------
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 数据源 ----------
# TODO: 填你的真实 token
TUSHARE_TOKEN=

# ---------- 采集并发 ----------
COLLECT_CONCURRENCY=3
COLLECT_MAX_CONCURRENCY=8
COLLECT_CHUNK_SIZE=30

# ---------- API ----------
API_V1_PREFIX=/api/v1

# ---------- 邮件 SMTP(邮箱验证码) ----------
# 复制 backend/.env.smtp.example 填写后,把变量粘到本文件(.env.local)或 .env
# 推荐:QQ 邮箱「授权码」(不是登录密码);详细说明见 .env.smtp.example
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_SUBJECT_PREFIX=[归因分析]
SYSTEM_ACCOUNTS=zch
