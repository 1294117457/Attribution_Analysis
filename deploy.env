# deploy.env — K8s 部署参数（含敏感信息，不入 git）
# 用法：
#   source deploy.env
#   envsubst < postgres/k8s-postgres.yaml | kubectl apply -f -
#   envsubst < redis/k8s-redis.yaml | kubectl apply -f -

# === 镜像源（阿里云个人版 ACR）===
