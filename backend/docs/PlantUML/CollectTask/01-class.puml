'  8. 路由层 — Router 瘦身
' ═════════════════════════════════════════════════════════════════════════════════════════════
package "路由层 (route/api/v1/)" #ECEFF1 {

  class CollectTaskRouter <<REFACTOR>> #FFE0B2 {
    + POST  /collect/tasks          __ create_task: handler = registry.get(task_type) __
    + GET   /collect/tasks          __ 列表 __
    + GET   /collect/tasks/{id}     __ 详情 __
    + GET   /collect/tasks/{id}/progress __ Redis HGETALL __
    + POST  /collect/tasks/{id}/cancel  __ request_cancel(task_id) __
    --
    __ 行数: 468 → ~150 (-68%) __
    __ 白名单不再硬编码，从 registry 动态读 __
  }

  class ConceptRouter <<UNCHANGED>> #E0E0E0 {
    + POST /concepts/sync           __ 路由级同步（同步返回 VO） __
    --
    __ 保留: 不走采集管理 tab 的快速同步入口 __
    __ 区别: 走 ConceptAppService.sync_concepts() 直接调 __
  }

  CollectTaskRouter ..> CollectTaskRegistry : <<get_collect_task_registry>>
  CollectTaskRouter ..> BaseCollectTask     : <<execute_task(task_id, handler, params)>>
}


