@startuml StockInfo_N1_Fix

title StockInfo N+1 修复 — 跨层类图修改概览

left to right direction

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13

' ═══════════════════════════════════════════════════════════════════════════
'  StockInfo N+1 优化 — 阶段一：with_pools 参数 + 批量反向查询
'  主题：将"列表 + N 次反向查询池"合并为单次请求返回
'  统一设计文档：docs/dev/05listn1/README.md
'  设计演进：02-modification.md → 05listn1/README.md（统一）
'
'  修正要点：
'  ① 去除原设计 B 中"复用 PoolVO"的方案，统一新增 PoolMembershipVO
'  ② PoolMembershipVO 字段补 join_at，部署于 application/dto/pool.py
'  ③ StockPoolBrief 设计定义后决定不实施（统一设计文档达成）
' ═══════════════════════════════════════════════════════════════════════════

legend right
  |= 颜色 |= 含义 |
  | <#C8E6C9>绿 | 新增（NEW） |
  | <#FFE0B2>橙 | 修改（CHANGED） |
  | <#E0E0E0>灰 | 不变（UNCHANGED） |
endlegend


' ═══════════════════════════════════════════════════════════════════════════
'  1. 持久层（DB / ORM）— 完全不变
' ═══════════════════════════════════════════════════════════════════════════
package "持久层 (Persistence / ORM)" #ECEFF1 {

  class StockInfoDB <<UNCHANGED>> #E0E0E0 {
    + symbol {PK}
    + name
    + industry
    + market
    + list_date
    + list_status
    + is_hs
    + total_shares
    + act_name
    + act_ent_type
  }

  class StockPoolDB <<UNCHANGED>> #E0E0E0 {
    + id {PK}
    + name
    + pool_type
    + is_default
    + is_archived
  }

  class StockPoolMemberDB <<UNCHANGED>> #E0E0E0 {
    + pool_id {PK,FK}
    + symbol {PK,FK}
    + memo
    + sort_order
    + added_at
  }

}

StockPoolDB "1" --o "0..*" StockPoolMemberDB : pool_id
StockInfoDB "1" --o "0..*" StockPoolMemberDB : symbol


' ═══════════════════════════════════════════════════════════════════════════
'  2. 领域层 — 聚合根 + 仓储协议
' ═══════════════════════════════════════════════════════════════════════════
package "领域层 (Domain)" #F5F5DC {

  class StockInfo <<聚合根, UNCHANGED>> #E0E0E0 {
    + symbol
    + name
    + industry : Industry?
    + market : Market?
    --
    to_dict() : dict
    create() : StockInfo
  }

  class StockPool <<聚合根, UNCHANGED>> #E0E0E0 {
    + id
    + name
    + pool_type : PoolType
    + is_default
    + is_archived
  }

  class StockInfoRepository <<UNCHANGED>> #E0E0E0 {
    + list_with_kline_stats_paginated(
    +   q, industry, market, exchange,
    +   is_hs, list_status, exclude_st,
    +   min_total_mv, page, page_size
    + )
  }

  class StockPoolRepository <<Protocol, CHANGED>> #FFE0B2 {
    + find_pools_by_symbol(symbol)
    +   : list[StockPool]
    + list_membership_by_symbols(symbols)  ' 🆕
    +   : dict[symbol, list[PoolMembershipVO]]
  }

  StockInfoRepository ..> StockInfo
  StockPoolRepository ..> StockPool
}


' ═══════════════════════════════════════════════════════════════════════════
'  3. DTO 层 — 新增 PoolMembershipVO（统一放置于 pool DTO 模块）
' ═══════════════════════════════════════════════════════════════════════════
package "DTO 层 (API Boundary)" #FFF3E0 {

  class "Page[T]\n<<Generic>>" as Page <<NEW>> #C8E6C9 {
    + items : List[T]
    + total : int
    + page : int
    + page_size : int
    + pages : int
    --
    + from_list(items, total,
                page_num, page_size)
      : Page[T]
  }

  class PoolMembershipVO <<NEW>> #C8E6C9 {
    + pool_id : int
    + name : str
    + pool_type : str
    + joined_at : Optional[str] = None
    --
    __ 池成员关系 DTO，列表/详情通用 __
    __ 字段对齐前后端命名规范 __
    __ 部署：application/dto/pool.py __
  }

  class StockQueryRequest <<CHANGED>> #FFE0B2 {
    + q : Optional[str]
    + industry : Optional[str]
    + market : Optional[str]
    + exchange : Optional[str]
    + is_hs : Optional[str]
    + list_status : Optional[str]
    + exclude_st : Optional[bool]
    + min_total_mv : Optional[float]
    + with_pools : bool = False    ' 🆕 新增参数
    + page : int = 1
    + page_size : int = 20
  }

  class StockQueryItemResponse <<CHANGED>> #FFE0B2 {
    + symbol : str
    + ts_code : Optional[str]
    + name : Optional[str]
    + industry : Optional[str]
    + market : Optional[str]
    + exchange : Optional[str]
    + list_date : Optional[str]
    + list_status : Optional[str]
    + is_hs : Optional[str]
    + act_name : Optional[str]
    + act_ent_type : Optional[str]
    + total_shares : Optional[int]
    + record_count : int
    + kline_start : Optional[str]
    + kline_end : Optional[str]
    + latest_close : Optional[float]
    + total_mv : Optional[float]
    + pe_ttm : Optional[float]
    + profit_margin : Optional[float]
    + pools : list[PoolMembershipVO] = []  ' 🆕 新增字段
  }

  class StockQueryResponse <<UNCHANGED>> #E0E0E0 {
    + total : int
    + page : int
    + page_size : int
    + items : list[StockQueryItemResponse]
  }

  StockQueryItemResponse "1" *-- "0..*" PoolMembershipVO : pools >
  StockQueryResponse   "1" *-- "1..*" StockQueryItemResponse : items >

  note bottom of PoolMembershipVO
    统一放置于 application/dto/pool.py
    不重复定义在 stock.py / panel.py 中
  end note
}


' ═══════════════════════════════════════════════════════════════════════════
'  4. 仓储实现层（Infra）— 新增批量反向查询实现
' ═══════════════════════════════════════════════════════════════════════════
package "仓储实现层 (Infra / Repository Impl)" #F3E5F5 {

  class StockRepoImpl <<UNCHANGED>> #E0E0E0
  class PoolRepoImpl <<CHANGED>> #FFE0B2 {
    + list_membership_by_symbols(symbols)
        : dict[symbol, list[PoolMembershipVO]]
    --
    __ WHERE symbol IN (:symbols) __
    __ AND is_archived = false __
    __ ORDER BY is_default DESC, updated_at DESC __
  }

  StockInfoRepository <|.. StockRepoImpl
  StockPoolRepository <|.. PoolRepoImpl

}

StockRepoImpl ..> StockInfoDB
PoolRepoImpl ..> StockPoolMemberDB
PoolRepoImpl ..> StockPoolDB


' ═══════════════════════════════════════════════════════════════════════════
'  5. 应用服务层 — 注入 pool_repo，编排合并
' ═══════════════════════════════════════════════════════════════════════════
package "应用服务 (Application)" #E3F2FD {

  class StockAppService <<CHANGED>> #FFE0B2 {
    - _repo : StockInfoRepository
    - _pool_repo : StockPoolRepository   ' 🆕 新依赖
    --
    + query_stocks(request)
      : StockQueryResponse
  }

  class StockPoolAppService <<UNCHANGED>> #E0E0E0 {
    + find_pools_by_symbol(symbol)
      : list[StockPool]
  }

  StockAppService --> StockRepoImpl
  StockAppService --> PoolRepoImpl : <<新依赖>>
  StockPoolAppService --> PoolRepoImpl

  note bottom of StockAppService
    query_stocks(req) 伪代码：
    ① rows, total = await repo.list_with_kline_stats_paginated(...)
    ② 若 req.with_pools:
         pool_map = await _pool_repo.list_membership_by_symbols(
                       [r["symbol"] for r in rows]
                    )
    ③ items = [StockQueryItemResponse(**r, pools=pool_map.get(r["symbol"], []))
                for r in rows]
    ④ return StockQueryResponse(total, page, page_size, items)
  end note
}


' ═══════════════════════════════════════════════════════════════════════════
'  6. 路由层 — 新增 with_pools query 参数
' ═══════════════════════════════════════════════════════════════════════════
package "路由层 (Route)" #FCE4EC {

  class GET_Stocks <<CHANGED>> #FFE0B2 {
    + GET /api/v1/stocks/
    +   q, industry, market, exchange
    +   is_hs, list_status, exclude_st
    +   min_total_mv
    +   with_pools : bool = False    ' 🆕 新增参数
    +   page, page_size
    --
    __ 默认 false，向后兼容 __
  }

  class GET_PoolsBySymbol <<UNCHANGED>> #E0E0E0 {
    + GET /api/v1/pools/by-symbol/{symbol}
    --
    __ 保留：详情页 / 其他场景 __
  }

}


' ═══════════════════════════════════════════════════════════════════════════
'  7. 调用对比（Before vs After）
' ═══════════════════════════════════════════════════════════════════════════
package "调用对比 (Before vs After)" #FAFAFA {

  class "Frontend\n(StockInfoList.vue)" as FE <<UI>> #E0E0E0 {
    + 列表展示
    + 池信息展示
  }

  class "Before : 23 HTTP / 页" as Before <<OLD>> #FFCDD2 {
    + 1× GET /stocks/?page=1&page_size=20
    + 1× GET /stocks/meta
    + 1× GET /pools?limit=100
    + 20× GET /pools/by-symbol/{symbol}
    --
    __ Promise.all(symbols.map(...)) __
    __ 典型 N+1 反模式 __
  }

  class "After : 3 HTTP / 页" as After <<NEW>> #C8E6C9 {
    + 1× GET /stocks/?page=1&page_size=20&with_pools=true
    + 1× GET /stocks/meta
    --
    __ pools 已内嵌在 items[].pools 中 __
  }

  Before --> StockAppService : <<旧路径>>
  After  --> StockAppService : <<新路径>>

}

FE --> Before
FE --> After


' ═══════════════════════════════════════════════════════════════════════════
'  关系汇总
' ═══════════════════════════════════════════════════════════════════════════
GET_Stocks        --> StockAppService
GET_PoolsBySymbol --> StockPoolAppService

StockAppService ..> StockQueryRequest       : <<读取>>
StockAppService ..> StockQueryItemResponse  : <<构造>>
StockAppService ..> PoolMembershipVO        : <<组装>>

@enduml
