'  2. 子类实现 — 4 个 task_type
' ═════════════════════════════════════════════════════════════════════════════════════════════
package "子类实现 (infrastructure/tasks/collect/*.py)" #ECEFF1 {

  class DailyKlineCollectTask <<REFACTOR>> #FFE0B2 {
    + name = "daily_kline"
    - _settings : Settings
    - _concurrency : int
    - _fetcher_pool : asyncio.Queue[KlineFetcher]
    --
    + estimate_total(params) : int     __ 查 StockInfoDB 数 __
    + pre_execute(params)              __ 创建 N 个 KlineFetcher __
    + run(params, on_unit_done) : TaskSummary
    --
    __ 单元: 每只股票 symbol __
    __ 迁移自: collect_task.py:172-292 (121 行) __
  }

  class DailyBasicCollectTask <<REFACTOR>> #FFE0B2 {
    + name = "daily_basic"
    --
    + estimate_total(params) : int     __ 按 days / trade_date 计 __
    + run(params, on_unit_done) : TaskSummary
    --
    __ 单元: 每个 trade_date __
    __ 迁移自: collect_task.py:294-352 (62 行) __
  }

  class StockBasicCollectTask <<REFACTOR>> #FFE0B2 {
    + name = "stock_basic"
    --
    + estimate_total(params) : int = 1 __ 无明确单元 __
    + run(params, on_unit_done) : TaskSummary
    --
    __ 单元: 仅 1 个（stock_basic 整体） __
    __ 迁移自: collect_task.py:354-400 (45 行) __
  }

  class ConceptCollectTask <<NEW>> #C8E6C9 {
    + name = "concept"
    - _fetcher : AkShareConceptFetcher
    --
    + estimate_total(params) : int     __ fetch_concept_list 拿总数 __
    + run(params, on_unit_done) : TaskSummary
    - _sync_one(bo : ConceptListBO) : int  __ 委托给 ConceptSyncOperation __
    --
    __ 单元: 每个概念 __
    __ 复用: ConceptSyncOperation._sync_one() 业务零改动 __
    __ 本次重点交付：让概念同步接入采集管理 tab __
  }

  BaseCollectTask <|-- DailyKlineCollectTask
  BaseCollectTask <|-- DailyBasicCollectTask
  BaseCollectTask <|-- StockBasicCollectTask
  BaseCollectTask <|-- ConceptCollectTask

  CollectTaskRegistry "1" *--> "0..*" DailyKlineCollectTask   : daily_kline
  CollectTaskRegistry "1" *--> "0..*" DailyBasicCollectTask   : daily_basic
  CollectTaskRegistry "1" *--> "0..*" StockBasicCollectTask   : stock_basic
  CollectTaskRegistry "1" *--> "0..*" ConceptCollectTask       : concept
}


