# backend env 模板（compose env_file）
# ⚠️ 复制为 .env 后填入真实值；`.env` 已在 .gitignore 中，禁止提交

# ── 服务 ──────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
DEBUG=false

# ── PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/attribution_db
# raw_data_db（采集数据物理库；与 attribution_db 业务库隔离）
RAW_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/raw_data_db

# ── 连接池 ────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── 数据源 ───────────────────────────────────────────
TUSHARE_TOKEN=
# 禁用的采集工具（逗号分隔，如 "akshare,pytdx"）
DATA_SOURCE_DISABLED=

# ── 采集并发 ──────────────────────────────────────────
COLLECT_CONCURRENCY=3
COLLECT_MAX_CONCURRENCY=8
COLLECT_CHUNK_SIZE=30
COLLECT_SCHEDULER_ENABLED=true
COLLECT_SCHEDULER_TIMEZONE=Asia/Shanghai

# ── API ───────────────────────────────────────────────
API_V1_PREFIX=/api
# CORS 允许的跨域来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── 邮件 SMTP（邮箱验证码）────────────────────────────
# ⚠️ SMTP_PASSWORD 用 QQ 邮箱「授权码」，不是登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_SUBJECT_PREFIX=[归因分析]

# ── 验证码策略 ────────────────────────────────────────
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_RL_1M=1
VERIFICATION_CODE_RL_1H=5

# 业务「系统账号」白名单（英文逗号分隔，不受 1 小时 5 次限制）
SYSTEM_ACCOUNTS=

# ═══════════════════════════════════════════════════════════════════
#  JWT 签名密钥（★ 最高敏感度，禁止提交 / 禁止写入本文件后上传）
# ═══════════════════════════════════════════════════════════════════
# 优先级：下面的环境变量 > backend/.keys/ 运行时自动生成的密钥
#
# ⚠️ 生产环境**必须**显式配置：容器多副本时自动生成的密钥彼此不同
#    → 一个实例签发的 token 到了另一个实例验签失败 → 401。
#
# 生成方式（RSA 2048 / PKCS8 PEM）：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -pubout -in jwt_private.pem -out jwt_public.pem
#
# ⚠️ `.env` 是单行文本格式，多行 PEM 必须把换行写成字面量 `\n`：
#   JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
#   JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n
#
# 留空 → key_manager 自动生成并落盘到 backend/.keys/（仅适用于本地开发）
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
