# public.env.example — 公共参数模板（脱敏版）
# 目标部署路径：/home/project/k8s/
# 用法：
#   cd /home/project/k8s/public
#   cp public.env.example public.env
#   vim public.env          # 修改下面 4-7 个变量
#   source public.env       # 让 deploy.sh / reset.sh / envsubst 能读到
#
# 必改项：
#   - TAILSCALE_IP   节点 Tailscale IP（kubeadm init 用，节点互联用）
#   - NODE_NAME      节点 hostname（`hostname` 命令输出）
#   - ACR_PREFIX     阿里云 ACR 个人版地址
#
# 视情况改：
#   - FLANNEL_IFACE  tailscale0（用 Tailscale 内网加速）/ eth0（默认，普通环境）
#   - DASHBOARD_NODEPORT  NodePort 端口（30000-32767 范围，默认 30080）
#
# 一般不用改：
#   - K8S_VERSION / PAUSE_VERSION / FLANNEL_VERSION / FLANNEL_CNI_PLUGIN_VERSION
#   - DASHBOARD_VERSION / DASHBOARD_METRICS_SCRAPER_VERSION
#   - POD_SUBNET / SERVICE_SUBNET / SSH_USER

# === 网络 ===
export TAILSCALE_IP=100.100.100.100
export NODE_NAME=node1
export POD_SUBNET=10.244.0.0/16
export SERVICE_SUBNET=10.96.0.0/12

# === 镜像源（阿里云个人版 ACR）===
# 格式：crpi-xxxxxxxx.cn-shenzhen.personal.cr.aliyuncs.com/<你的命名空间>
export ACR_PREFIX=crpi-xxxxxxxxxxxxxx.cn-shenzhen.personal.cr.aliyuncs.com/<your-namespace>

# === K8s 版本 ===
export K8S_VERSION=v1.33.13

# === containerd pause 镜像版本 ===
export PAUSE_VERSION=3.10.2

# === flannel ===
export FLANNEL_VERSION=v0.28.9
export FLANNEL_CNI_PLUGIN_VERSION=v1.9.1-flannel3
export FLANNEL_IFACE=tailscale0          # tailscale0 | eth0

# === dashboard ===
export DASHBOARD_VERSION=v2.7.0
export DASHBOARD_METRICS_SCRAPER_VERSION=v1.0.8
export DASHBOARD_NODEPORT=30080

# === SSH（deploy.sh 用，可选）===
export SSH_USER=ubuntu