  class StockPanelAppService <<CHANGED>> #FFE0B2 {
    - _panel_repo : StockPanelComposeRepository
    - _concept_app? : ConceptAppService    ' 🆕
    --
    + query_panels(req) : StockPanelListVO
      伪代码：
      ① repo.list_paginated(req)
