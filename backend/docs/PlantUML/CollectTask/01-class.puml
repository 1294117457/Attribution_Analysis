' ═════════════════════════════════════════════════════════════════════════════════════════════
'  采集管理类设计重构
'  统一设计文档：docs/dev/07collect-class/01-collect-task-class-design.md
'
'  重构要点：
'  ① 模板方法：BaseCollectTask 抽象 run() + estimate_total()
'  ② 注册表：CollectTaskRegistry 让 router 白名单零硬编码
'  ③ 概念接入：ConceptCollectTask 复用 ConceptSyncOperation._sync_one()
'  ④ Router 瘦身：collect_task.py 从 468 行 → ~150 行
'
'  数据治理决策：
'  · 框架负责"通用"（进度 / 取消 / 收尾 / 并发安全）
'  · 子类只负责"业务"（单元是什么 / 按什么顺序跑 / 跑完一个做什么）
' ═════════════════════════════════════════════════════════════════════════════════════════════

legend right
  |= 颜色 |= 含义 |
  | <#C8E6C9>绿 | 新增 (NEW) |
  | <#FFE0B2>橙 | 重构/迁移 (REFACTOR) |
  | <#E0E0E0>灰 | 既有不动 (UNCHANGED) |
endlegend


' ═════════════════════════════════════════════════════════════════════════════════════════════
'  1. 抽象层 — 模板方法骨架
' ═════════════════════════════════════════════════════════════════════════════════════════════
package "抽象层 (infrastructure/tasks/collect/)" #ECEFF1 {

  abstract class BaseCollectTask <<ABSTRACT, NEW>> #C8E6C9 {
    + name : ClassVar[str]
    --
    __ 抽象方法 (子类必须实现) __
    + {abstract} estimate_total(params : dict) : int
    + {abstract} run(params, on_unit_done : Callable) : TaskSummary
    --
    __ 钩子 (子类可选覆盖) __
    + pre_execute(params)
    + post_execute(params, summary : TaskSummary)
    --
    __ framework 内部 (子类勿调) __
    - _update_progress(redis, task_id, label, result : UnitResult)
    - _finish_task(session_factory, task_id, status, summary, message)
    --
    {static} + execute_task(task_id, handler, params)
        __ 模板方法本体：pre_execute → estimate_total → run → 收尾 __
        __ 取消检查放在 on_unit_done 闭包内 __
  }

  class UnitResult <<NEW, frozen dataclass>> #C8E6C9 {
    + success : bool
    + detail : str = ""
    + error : str | None = None
    + skipped : bool = False
    + saved_count : int = 0
  }

  class TaskSummary <<NEW, frozen dataclass>> #C8E6C9 {
    + success : int
    + fail : int
    + skip : int = 0
    + message : str = ""
    + total_count : int = 0
    + elapsed_ms : int = 0
  }

  class Cancelled <<NEW, Exception>> #C8E6C9 {
    __ 子类 run() 内 raise 即可中断 __
  }

  class CollectTaskRegistry <<NEW>> #C8E6C9 {
    - _handlers : dict[str, BaseCollectTask]
    --
    + register(task_type, handler)
    + get(task_type) : BaseCollectTask | None
    + supported_types() : list[str]
    --
    {static} + setup_collect_task_registry(handlers : list)
    {static} + get_collect_task_registry() : CollectTaskRegistry
  }

  note right of BaseCollectTask
    **契约：**
    ① estimate_total 必须同步（router 创建任务时同步调）
    ② run 每完成一个单元立即 on_unit_done(result, label)
    ③ 业务异常不逃出 run，捕获后包装成 UnitResult(success=False)
    ④ 需要取消可 raise Cancelled()
    ⑤ post_execute 在 finally 内保证清理
  end note

  note bottom of CollectTaskRegistry
    **与既有 infrastructure/tasks/registry.py 区分：**
    · 既有 registry.py 管 asyncio.Task 生命周期（池操作 PoolOperation 用）
    · 本 CollectTaskRegistry 管 task_type → handler 字典（采集管理用）
    · 两者职责不同，并存
  end note

  BaseCollectTask ..> UnitResult      : <<使用>>
  BaseCollectTask ..> TaskSummary     : <<返回>>
  BaseCollectTask ..> Cancelled       : <<抛出>>
  CollectTaskRegistry o--> BaseCollectTask : <<注册>>
}


